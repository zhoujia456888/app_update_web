{
  "name": "app_update_web",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --port 5802",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "clean": "bun -e \"import { rm } from 'node:fs/promises'; await Promise.all(['.nuxt', '.nitro'].map((dir) => rm(dir, { recursive: true, force: true })))\"",
    "rebuild": "bun run clean && bun run postinstall"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.87",
    "@nuxt/ui": "^4.4.0",
    "axios": "1.15.0",
    "nuxt": "^4.3.0",
    "typescript": "^5.9.3",
    "vue": "^3.5.27",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@tailwindcss/language-server": "^0.14.29",
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18"
  }
}
